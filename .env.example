# ============================================================
# AIOps Sentinel — Environment Variables Template
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----- AWS Configuration -----
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# ----- Environment -----
ENVIRONMENT=dev   # dev | staging | prod

# ----- Groq AI -----
GROQ_API_KEY=gsk_your_key_here   # https://console.groq.com/keys
GROQ_MAX_TOKENS=2048

# ----- SNS -----
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:aiops-alerts

# ----- DynamoDB -----
DYNAMODB_TABLE_NAME=aiops-incidents

# ----- Discord -----
# Create a webhook: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# ----- Logging -----
LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR

# ----- Lambda -----
LAMBDA_FUNCTION_NAME_PROCESSOR=aiops-incident-processor
LAMBDA_TIMEOUT=300
LAMBDA_MEMORY=512

# ----- S3 -----
S3_LOG_ARCHIVE_BUCKET=aiops-log-archive-dev

# ----- Monitoring -----
CPU_ALARM_THRESHOLD=80
MEMORY_ALARM_THRESHOLD=85
ERROR_RATE_THRESHOLD=5
