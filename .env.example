# ============================================================
# AIOps Sentinel — Environment Variables Template
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----- AWS Configuration -----
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# ----- Environment -----
ENVIRONMENT=dev   # dev | staging | prod

# ----- Bedrock -----
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MAX_TOKENS=2048

# ----- SNS -----
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:aiops-alerts

# ----- DynamoDB -----
DYNAMODB_TABLE_NAME=aiops-incidents

# ----- Slack (fetched from Secrets Manager in prod) -----
# Only for local dev/testing — use Secrets Manager in AWS
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#aiops-alerts

# ----- Secrets Manager -----
SECRETS_MANAGER_SLACK_SECRET_NAME=aiops/slack/webhook

# ----- Logging -----
LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR

# ----- Lambda -----
LAMBDA_FUNCTION_NAME_PROCESSOR=aiops-incident-processor
LAMBDA_FUNCTION_NAME_ANALYZER=aiops-ai-analyzer
LAMBDA_TIMEOUT=300
LAMBDA_MEMORY=512

# ----- S3 -----
S3_LOG_ARCHIVE_BUCKET=aiops-log-archive-dev

# ----- Monitoring -----
CPU_ALARM_THRESHOLD=80
MEMORY_ALARM_THRESHOLD=85
ERROR_RATE_THRESHOLD=5
